# Auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Neo4j (leave blank to run in mock-data mode against the graph store)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Live rescoring loop
RESCORE_INTERVAL_MINUTES=5

# Audit log file
AUDIT_LOG_PATH=audit.log

# ---------------------------------------------------------------------------
# Traffic Correlation Engine (§3.5)
# ---------------------------------------------------------------------------
# Capture mode. With TRAFFIC_CAPTURE_ENABLED=false and no PCAP_REPLAY_PATH the
# engine seeds deterministic demo fixtures — /traffic/* works with zero setup.
#
# LIVE tshark capture:
#   1. Install Wireshark + Npcap (Windows) / tshark (Linux).
#   2. TRAFFIC_CAPTURE_ENABLED=true
#      TSHARK_PATH   = full path on Windows, e.g. C:\Program Files\Wireshark\tshark.exe
#      TSHARK_INTERFACE = interface *number* from `tshark -D` (Windows) or name (Linux)
#   3. Give tshark real Bitcoin P2P packets to see — run the bundled listener
#      next to the backend:  python scripts/btc_p2p_feed.py --peers 10
#   A missing tshark / empty capture logs a warning and falls back to demo mode.
TRAFFIC_CAPTURE_ENABLED=false
TSHARK_PATH=tshark
TSHARK_INTERFACE=
TSHARK_CAPTURE_FILTER=tcp port 8333
# A .pcap/.pcapng (parsed via tshark) or a .jsonl of TrafficEvent lines.
PCAP_REPLAY_PATH=

# Correlation window + hard memory bound.
TRAFFIC_WINDOW_SECONDS=60
TRAFFIC_MAX_EVENTS=50000

# Burst detection: score ramps 0 -> 1 as the rate goes from BASELINE to
# BASELINE * THRESHOLD_RATIO (events per second).
TRAFFIC_BURST_BASELINE_RATE=2.0
TRAFFIC_BURST_THRESHOLD_RATIO=3.0

# Peers within this many ms count as "near-simultaneous"; peer counts above
# EXPECTED_FANOUT raise the propagation-irregularity feature.
TRAFFIC_NEAR_SIMULTANEOUS_MS=60
TRAFFIC_EXPECTED_FANOUT=8

# Explainable anomaly score = weighted sum of the four features.
TRAFFIC_WEIGHT_BROADCAST_TIMING=0.20
TRAFFIC_WEIGHT_BURST=0.30
TRAFFIC_WEIGHT_PEER_CONCENTRATION=0.25
TRAFFIC_WEIGHT_PROPAGATION_IRREGULARITY=0.25

# ---------------------------------------------------------------------------
# SentriX AI assistant (POST /ai/chat)
# ---------------------------------------------------------------------------
AI_ENABLED=true
# Provider — falls back to `mock` whenever AI_API_KEY is empty:
#   mock   = deterministic, no key, routes over the real SentriX tools (default).
#   gemini = native Google Gemini (generateContent). Handles the `thought_signature`
#            that Gemini 3.x "thinking" models require on tool calls; retries 5xx.
#            AI_BASE_URL = https://generativelanguage.googleapis.com/v1beta
#            AI_MODEL    = gemini-flash-lite-latest   (fast, no forced reasoning)
#                          gemini-flash-latest is a *thinking* model — much slower,
#                          bump AI_TIMEOUT_SECONDS to ~90 if you use it.
#            Key from https://aistudio.google.com/apikey
#   openai = any OpenAI-compatible /chat/completions API (OpenAI, Groq, Azure…).
#            AI_BASE_URL = https://api.openai.com/v1     AI_MODEL = gpt-4o-mini
# The real key lives only in backend/.env (gitignored), never in this file.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200
AI_TIMEOUT_SECONDS=30
AI_MAX_TOOL_CALLS=5
AI_MAX_CONTEXT_ITEMS=20
AI_HISTORY_LIMIT=12
# Gemini only: extended-thinking token budget. 0 disables it (a lite model
# rejects any thinkingConfig — use -1 there); -1 leaves the model default on.
AI_THINKING_BUDGET=0

# ---------------------------------------------------------------------------
# CoinGecko market data — powers the assistant's live price / market tools
# (get_crypto_price, get_coin_market_data, get_crypto_market_overview).
# ---------------------------------------------------------------------------
# Free "Demo" key from https://www.coingecko.com/en/developers/dashboard.
# Blank => those three tools report "not configured"; the rest of the
# assistant is unaffected. The real key lives only in backend/.env.
COINGECKO_API_KEY=
# true only for a paid key (uses pro-api.coingecko.com + the pro header).
COINGECKO_PRO=false
COINGECKO_TIMEOUT_SECONDS=6
